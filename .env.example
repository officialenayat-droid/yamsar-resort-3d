# Copy to .env and fill in.
# Admin dashboard password (at /admin). If unset, one is generated on first run and printed to the console.
ADMIN_PASSWORD=
# Port for the booking API / production server
PORT=8787
# Where the SQLite database lives (back this file up!)
DB_PATH=data/yamsar.db
# Set to 1 when running behind a reverse proxy (nginx, Render, Railway…) so rate limits see real client IPs
TRUST_PROXY=0

# ── Email notifications (SMTP) ──
# Gmail: turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yamsarresort@gmail.com
SMTP_PASS=
# "From" shown to recipients (defaults to SMTP_USER)
MAIL_FROM="The Yamsar Resort <yamsarresort@gmail.com>"
# Public address of the site, used for the "Review & confirm" link in alerts
SITE_URL=https://yamsarresort.in
