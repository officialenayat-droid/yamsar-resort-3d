# Copy to .env for local use. On Hostinger, add these under the app's Environment variables
# (or use "Import .env"). Never commit real values.

# ── Admin ──
# Password for the very first admin login (at /admin). Afterwards, change it in Admin → Settings.
# If unset, one is generated on first start and printed in the logs.
ADMIN_PASSWORD=
# Set to 1 (with a new ADMIN_PASSWORD) to force-reset a forgotten password, then remove it.
ADMIN_PASSWORD_RESET=

# ── Database (Hostinger MySQL) ──
# Create it in hPanel → Websites → Manage → Databases. Use 127.0.0.1, not localhost.
# Leave all DB_* empty locally to use a SQLite file instead (data/yamsar.db).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=
# Alternatively one URL: mysql://user:pass@127.0.0.1:3306/dbname  (or postgres://… for Postgres)
DATABASE_URL=

# ── Email notifications (SMTP) ──
# Gmail: turn on 2-Step Verification, create an App Password at https://myaccount.google.com/apppasswords
# Hostinger email: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465, your mailbox address + password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yamsarresort@gmail.com
SMTP_PASS=
MAIL_FROM="The Yamsar Resort <yamsarresort@gmail.com>"
# Public address of the site, used for the "Review & confirm" link in alert emails
SITE_URL=https://yamsarresort.in

# ── Local only ──
PORT=8787
DB_PATH=data/yamsar.db
